This Works with only small letters English Alphabets :

class Solution {

    public int longestNonRepeatingSubstring(String s) {
        int n = s.length();
        int l =0;
        int r =0;
        int len = 0;
        int maxLen = 0;

        int[] freq = new int[26];
        while(r < n){
            freq[s.charAt(r) - 'a']++;

            while(freq[s.charAt(r) - 'a'] > 1){
                freq[s.charAt(l) - 'a']--;
                l++;
            }

            if(freq[s.charAt(r) - 'a'] <= 1){
                maxLen = Math.max(maxLen , r-l+1);
            }
            r++;
        }
        return maxLen;
    }
}


